  CreateDirectory "$SMPROGRAMS\ChromExplorer"
  CreateShortCut "$SMPROGRAMS\ChromExplorer\ChromExplorer.lnk" "$INSTDIR\ChromExplorer.exe"
  CreateShortCut "$DESKTOP\ChromExplorer.lnk" "$INSTDIR\ChromExplorer.exe"
  
  SetOutPath "$INSTDIR\x64"
  File "..\ChromExplorer\ChromExplorer\bin\Release\x64\SQLite.Interop.dll"
  SetOutPath "$INSTDIR\x86"
  File "..\ChromExplorer\ChromExplorer\bin\Release\x86\SQLite.Interop.dll"
  SetOutPath "$INSTDIR"
  SetOverwrite ifnewer
  File "readme.txt"

  ${registerExtension} "$INSTDIR\ChromExplorer.exe" ".mtd" "MT Explorer Chromatogram File"
  ${registerExtension} "$INSTDIR\ChromExplorer.exe" ".db3" "MT Explorer Chromatogram File (legacy extension)"
  
  AccessControl::GrantOnFile "$INSTDIR\" "(S-1-5-32-545)" "FullAccess"

SectionEnd

Section -vcredistr
  SetOutPath "$INSTDIR\Microsoft"
  File "c:\Program Files (x86)\Microsoft Visual Studio 10.0\VC\redist\1033\vcredist_x86.exe"
  ExecWait '"$INSTDIR\Microsoft\vcredist_x86.exe" /q /l $INSTDIR\vcredist.log'
SectionEnd

Section -AdditionalIcons
  WriteIniStr "$INSTDIR\${PRODUCT_NAME}.url" "InternetShortcut" "URL" "${PRODUCT_WEB_SITE}"
  CreateShortCut "$SMPROGRAMS\ChromExplorer\Website.lnk" "$INSTDIR\${PRODUCT_NAME}.url"
  CreateShortCut "$SMPROGRAMS\ChromExplorer\Uninstall.lnk" "$INSTDIR\uninst.exe"
SectionEnd

Section -Post
  WriteUninstaller "$INSTDIR\uninst.exe"
  WriteRegStr HKLM "${PRODUCT_DIR_REGKEY}" "" "$INSTDIR\ChromExplorer.exe"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "DisplayName" "$(^Name)"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "UninstallString" "$INSTDIR\uninst.exe"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "DisplayIcon" "$INSTDIR\ChromExplorer.exe"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "DisplayVersion" "${PRODUCT_VERSION}"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "URLInfoAbout" "${PRODUCT_WEB_SITE}"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "Publisher" "${PRODUCT_PUBLISHER}"
SectionEnd


Function un.onUninstSuccess
  HideWindow
  MessageBox MB_ICONINFORMATION|MB_OK "$(^Name) was successfully removed from your computer."
FunctionEnd

Function un.onInit
  MessageBox MB_ICONQUESTION|MB_YESNO|MB_DEFBUTTON2 "Are you sure you want to completely remove $(^Name) and all of its components?" IDYES +2
  Abort
FunctionEnd

