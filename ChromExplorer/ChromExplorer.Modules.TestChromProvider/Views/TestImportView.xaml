<UserControl x:Class="ChromExplorer.Modules.TestChromProvider.Views.TestImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:prism="clr-namespace:Microsoft.Practices.Prism.Interactivity.InteractionRequest;assembly=Microsoft.Practices.Prism.Interactivity" 
             xmlns:interactionRequest="clr-namespace:ChromExplorer.Infrastructure.InteractionRequest;assembly=ChromExplorer.Infrastructure" 
             mc:Ignorable="d" 
            >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="0, 5, 5, 5">Title</TextBlock>
                    <TextBlock Grid.Row="1" Margin="0, 5, 5, 5">Description</TextBlock>

                    <TextBox Grid.Column="1" Margin="5, 5, 0, 5" Text="{Binding Title}"></TextBox>
                    <TextBox Grid.Column="1" Grid.Row="1" Margin="5, 5, 0, 5" Height="50" Text="{Binding Description}" VerticalAlignment="Top" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Visible"></TextBox>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"></ColumnDefinition>
                        <ColumnDefinition Width="10"></ColumnDefinition>
                        <ColumnDefinition Width="1*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <Border Background="{StaticResource headerBarBG}" BorderBrush="AntiqueWhite" BorderThickness="3" CornerRadius="6">
                        <TextBlock Foreground="White" FontFamily="Tahoma" FontWeight="Bold" HorizontalAlignment="Center" Margin="5">Chromatogram</TextBlock>
                    </Border>
                    
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <TextBlock Margin="5,5,5,5">Points</TextBlock>
                        <TextBlock Grid.Row="1" Margin="5,5,5,5">Unused value</TextBlock>
                        <TextBlock Grid.Row="2" Margin="5,5,5,5">Unused value</TextBlock>
                        
                        <TextBox Grid.Column="1" Margin="5,5,5,5" Text="{Binding ChromPoints}"></TextBox>
                        <ComboBox Grid.Column="1" Grid.Row="1" Margin="5,5,5,5">
                            <ComboBoxItem>Item 1</ComboBoxItem>
                            <ComboBoxItem>Item 2</ComboBoxItem>
                            <ComboBoxItem>Item 3</ComboBoxItem>
                        </ComboBox>
                        <Slider Grid.Column="1" Grid.Row="2" Margin="5,5,5,5"></Slider>
                    </Grid>

                    <Border Grid.Column="2"  Background="{StaticResource headerBarBG}" BorderBrush="AntiqueWhite" BorderThickness="3" CornerRadius="6">
                        <TextBlock Foreground="White" FontFamily="Tahoma" FontWeight="Bold" HorizontalAlignment="Center" Margin="5">Spectrum</TextBlock>
                    </Border>

                    <Grid Grid.Row="1" Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <TextBlock Margin="5,5,5,5">Points</TextBlock>
                        <TextBlock Grid.Row="1" Margin="5,5,5,5">Unused value</TextBlock>
                        <TextBlock Grid.Row="2" Margin="5,5,5,5">Unused value</TextBlock>

                        <TextBox Grid.Column="1" Margin="5,5,5,5" Text="{Binding SpectrumPoints}"></TextBox>
                        <TextBox Grid.Column="1" Grid.Row="1" Margin="5,5,5,5"></TextBox>
                        <CheckBox Grid.Column="1" Grid.Row="2" Margin="5,5,5,5" HorizontalAlignment="Center"></CheckBox>
                    </Grid>

                </Grid>
            </Grid>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" HorizontalAlignment="Right">
            <Button Margin="5" Command="{Binding GenerateCommand}">Generate</Button>
    </StackPanel>
        <i:Interaction.Triggers>
            <prism:InteractionRequestTrigger SourceObject="{Binding GenerationInteractionRequest}">
                <interactionRequest:InteractionDialogAction>
                    <interactionRequest:InteractionDialogAction.Dialog>
                        <interactionRequest:LocalModalProgressDialog />
                    </interactionRequest:InteractionDialogAction.Dialog>
                    <interactionRequest:InteractionDialogAction.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                               
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </interactionRequest:InteractionDialogAction.ContentTemplate>
                </interactionRequest:InteractionDialogAction>
            </prism:InteractionRequestTrigger>
        </i:Interaction.Triggers>
    </Grid>
    
</UserControl>
