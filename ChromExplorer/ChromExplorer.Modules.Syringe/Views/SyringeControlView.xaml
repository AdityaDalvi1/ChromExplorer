<UserControl x:Class="ChromExplorer.Modules.Syringe.Views.SyringeControlView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:ca="clr-namespace:ChromExplorer.Assets;assembly=ChromExplorer.Assets"
         xmlns:controls="clr-namespace:ChromExplorer.Controls;assembly=ChromExplorer.Controls"
                  xmlns:settings="clr-namespace:ChromExplorer.Modules.Syringe.Settings"
                  mc:Ignorable="d" 
         d:DesignHeight="720" d:DesignWidth="1280">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"></RowDefinition>
            <RowDefinition Height="3*"></RowDefinition>
            <RowDefinition Height="1*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"></ColumnDefinition>
            <ColumnDefinition Width="3*"></ColumnDefinition>
            <ColumnDefinition Width="1*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Border Background="#99FFFFFF" Opacity="0.5" CornerRadius="12,12,12,12" VerticalAlignment="Stretch" Grid.RowSpan="3" Grid.ColumnSpan="3" />
        <Grid Grid.Row="1" Grid.Column="1">
            <Border BorderBrush="Black" CornerRadius="12,12,12,12"  Background="#FFC2CCDB"></Border>
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <StackPanel HorizontalAlignment="Right">
                    <Button Margin="3" MinWidth="18" MinHeight="18" Click="Button_Click">
                        <Image Height="16" Width="16" Source="{ca:Asset Icons/Actions/collapse.png}"></Image>
                    </Button>
                </StackPanel>
                <TabControl Grid.Row="1">
                    <TabItem Header="Control">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                            </Grid.RowDefinitions>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="10*"></ColumnDefinition>
                                        <ColumnDefinition Width="10"></ColumnDefinition>
                                        <ColumnDefinition Width="10*"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>

                                    <Border Background="{StaticResource headerBarBG}" BorderBrush="AntiqueWhite" BorderThickness="3" CornerRadius="6">
                                        <TextBlock Foreground="White" FontFamily="Tahoma" FontWeight="Bold" HorizontalAlignment="Center" Margin="5">General</TextBlock>
                                    </Border>

                                    <Grid Margin="3" Grid.Row="1" Grid.Column="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Row="0" Margin="5">Diameter (mm)</TextBlock>
                                        <TextBlock Grid.Row="1" Margin="5">Rate (µL/min)</TextBlock>
                                        <TextBlock Grid.Row="2" Margin="5">Volume (µL)</TextBlock>
                                        <TextBlock Grid.Row="3" Margin="5">Start MS</TextBlock>
                                        <TextBox Grid.Column="1" Margin="5" Text="{Binding Source={x:Static settings:SyringeModuleSettings.Default}, Path=SyringeDiameter, Mode=TwoWay}"></TextBox>
                                        <TextBox Grid.Column="1" Grid.Row="1" Margin="5" Text="{Binding Source={x:Static settings:SyringeModuleSettings.Default}, Path=SyringeRate, Mode=TwoWay}"></TextBox>
                                        <TextBox Grid.Column="1" Grid.Row="2" Margin="5" Text="{Binding Source={x:Static settings:SyringeModuleSettings.Default}, Path=Volume, Mode=TwoWay}"></TextBox>
                                        <CheckBox Grid.Column="1" Grid.Row="3" Margin="5" HorizontalAlignment="Center" IsChecked="{Binding StartMS}"></CheckBox>

                                        
                                    </Grid>



                                    <Border Grid.Column="2"  Background="{StaticResource headerBarBG}" BorderBrush="AntiqueWhite" BorderThickness="3" CornerRadius="6">
                                        <TextBlock Foreground="White" FontFamily="Tahoma" FontWeight="Bold" HorizontalAlignment="Center" Margin="5">Sample</TextBlock>
                                    </Border>


                                    <Grid Margin="3" Grid.Row="1" Grid.Column="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Row="0" Margin="5">Sample Name</TextBlock>
                                        <TextBlock Grid.Row="1" Margin="5">Modas Method</TextBlock>
                                        <TextBlock Grid.Row="2" Margin="5">Duration</TextBlock>
                                        <TextBlock Grid.Row="3" Margin="5">From Injection</TextBlock>
                                        <TextBox Grid.Column="1" Margin="5" Text="{Binding SampleName}"></TextBox>
                                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="5,5,5,5" VerticalContentAlignment="Stretch" VerticalAlignment="Stretch"
                                                  ItemsSource="{Binding RemoteMethods}"
                                                  SelectedItem="{Binding SelectedModasMethod}"
                                        ></ComboBox>
                                        <TextBox Grid.Row="2" Grid.Column="1" Margin="5" Text="{Binding AcquisitionDurationMin}"></TextBox>
                                        <CheckBox Grid.Column="1" Grid.Row="3" Margin="5" HorizontalAlignment="Center" IsChecked="{Binding UseInjectionDuration}"></CheckBox>

                                        
                                    </Grid>

                                </Grid>
                                
                            </ScrollViewer>
                            <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button Margin="5" Command="{Binding StartCommand}">Start</Button>
                                <Button Margin="5" Command="{Binding StopCommand}">Stop</Button>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Settings">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                            </Grid.RowDefinitions>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <controls:PortSettingsEditor DataContext="{Binding PortEditorContext}"></controls:PortSettingsEditor>
                            </ScrollViewer>
                            <StackPanel Grid.Row="1" HorizontalAlignment="Right">
                                <Button Margin="5" Command="{Binding ApplyCommand}">Apply</Button>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>


        </Grid>


    </Grid>
</UserControl>
