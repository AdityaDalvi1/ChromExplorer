<Window x:Class="ChromExplorer.Modules.ModasChromProvider.Tests.Forms.OpenModasFileDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:Views="clr-namespace:ChromExplorer.Modules.ModasChromProvider.Views;assembly=ChromExplorer.Modules.ModasChromProvider"
        mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ChromExplorer;component/Resources/WindowRegionResource.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/ChromExplorer;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <LinearGradientBrush x:Key="headerBarBG" EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FF284292"/>
                <GradientStop Color="#FF2175B8" Offset="0.26499998569488525"/>
            </LinearGradientBrush>
        </ResourceDictionary>
        
    </Window.Resources>
    <Grid>
        <Views:ModasImportView DataContext="{Binding}"></Views:ModasImportView>
    </Grid>
</Window>
