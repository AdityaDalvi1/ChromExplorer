<UserControl x:Class="ChromExplorer.Modules.WileyLibrary.Views.LibraryBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:assets="clr-namespace:ChromExplorer.Assets;assembly=ChromExplorer.Assets"
             xmlns:viewModels="clr-namespace:ChromExplorer.Modules.WileyLibrary.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300" d:DataContext="{d:DesignInstance Type=viewModels:LibraryBrowserViewViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10*"></ColumnDefinition>
                    <ColumnDefinition Width="10"></ColumnDefinition>
                    <ColumnDefinition Width="10*"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource headerBarBG}" BorderBrush="AntiqueWhite" BorderThickness="3" CornerRadius="6">
                    <TextBlock Foreground="White" FontFamily="Tahoma" FontWeight="Bold" HorizontalAlignment="Center" Margin="5">General</TextBlock>
                </Border>

                <Grid Grid.Row="1" Grid.RowSpan="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="5,5,5,5">Record number</TextBlock>
                    <TextBlock Margin="5,5,5,5" Grid.Row="1">Compaund</TextBlock>
                    <TextBlock Margin="5,5,5,5" Grid.Row="2">Mol Weight</TextBlock>
                    <TextBlock Margin="5,5,5,5" Grid.Row="3">CAS Number</TextBlock>
                    <TextBlock Margin="5,5,5,5" Grid.Row="4">Precursor Ion</TextBlock>
                    <TextBlock Margin="5,5,5,5" Grid.Row="5">Precursor Type</TextBlock>
                    <TextBlock Margin="5,5,5,5" Grid.Row="6">Ionization Type</TextBlock>
                    <TextBlock Margin="5,5,5,5" Grid.Row="7">Ionization Energy (eV)</TextBlock>


                    <TextBox Grid.Row="0" Grid.Column="1" Margin="5" Text="{Binding CurrentRecordNumber}"></TextBox>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="5" Text="{Binding CurrentRecord.Compaund}" IsReadOnly="True"></TextBox>
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="5" Text="{Binding CurrentRecord.MolWeight}" IsReadOnly="True"></TextBox>
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="5" Text="{Binding CurrentRecord.CASRegistryNo}" IsReadOnly="True"></TextBox>
                    <TextBox Grid.Row="4" Grid.Column="1" Margin="5" Text="{Binding CurrentRecord.PrecursorIon}" IsReadOnly="True"></TextBox>
                    <TextBox Grid.Row="5" Grid.Column="1" Margin="5" Text="{Binding CurrentRecord.PrecursorType}" IsReadOnly="True"></TextBox>
                    <TextBox Grid.Row="6" Grid.Column="1" Margin="5" Text="{Binding CurrentRecord.IonizationType}" IsReadOnly="True"></TextBox>
                    <TextBox Grid.Row="7" Grid.Column="1" Margin="5" Text="{Binding CurrentRecord.IonizationEnergy}" IsReadOnly="True"></TextBox>


                </Grid>

                <Border Grid.Row="2" Background="{StaticResource headerBarBG}" BorderBrush="AntiqueWhite" BorderThickness="3" CornerRadius="6">
                    <TextBlock Foreground="White" FontFamily="Tahoma" FontWeight="Bold" HorizontalAlignment="Center" Margin="5">Misc</TextBlock>
                </Border>

                <Grid Grid.Row="3" Grid.RowSpan="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>

                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="5,5,5,5">Peak Label Format</TextBlock>
                    <TextBlock Grid.Row="1" Margin="5,5,5,5">Peak Label Orientation</TextBlock>
                    <TextBlock Grid.Row="2" Margin="5,5,5,5">Peak Label Placement</TextBlock>
                    <TextBlock Grid.Row="3" Margin="5,5,5,5">Peak Label Placement</TextBlock>

                    <TextBox Grid.Column="1" Margin="5" Text="{Binding LabelFormat}"></TextBox>

                </Grid>

                <Border Grid.Column="2"  Background="{StaticResource headerBarBG}" BorderBrush="AntiqueWhite" BorderThickness="3" CornerRadius="6">
                    <TextBlock Foreground="White" FontFamily="Tahoma" FontWeight="Bold" HorizontalAlignment="Center" Margin="5">Structure</TextBlock>
                </Border>

                <Grid Grid.Column="2" Grid.Row="1"  HorizontalAlignment="Stretch" Margin="5">
                    <Image Width="{Binding ImageSize}" Height="{Binding ImageSize}" Margin="-9,0,0,0" Source="{Binding StructureImage}" ></Image>
                </Grid>

                <Border Grid.Column="2" Grid.Row="2"  Background="{StaticResource headerBarBG}" BorderBrush="AntiqueWhite" BorderThickness="3" CornerRadius="6" VerticalAlignment="Top">
                    <TextBlock Foreground="White" FontFamily="Tahoma" FontWeight="Bold" HorizontalAlignment="Center" Margin="5">Spectrum</TextBlock>
                </Border>

                <Grid Grid.Column="2" Grid.Row="3" Grid.RowSpan="3">
                    <TextBox AcceptsReturn="True" Text="{Binding SpectrumText}" VerticalScrollBarVisibility="Auto" Margin="5" Height="140"></TextBox>
                  
                    

                </Grid>

            </Grid>


        </ScrollViewer>
        <StackPanel Grid.Row="1" HorizontalAlignment="Left" Orientation="Horizontal" Margin="5">
            <Button Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Command="{Binding MoveLeftCommand}">
                <Image Height="16" Width="16" Margin="3" Source="{assets:Asset MetroIcons/Small/Swap-Left.png}"></Image>
            </Button>
            <Button Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Command="{Binding MoveRightCommand}">
                <Image Height="16" Width="16" Margin="3" Source="{assets:Asset MetroIcons/Small/Swap-Right.png}"></Image>
            </Button>
            <TextBlock Margin="40,5,5,5" Text="{Binding StatusText}"></TextBlock>
        </StackPanel>
    </Grid>
</UserControl>

    