<UserControl x:Class="ChromExplorer.Modules.Quan.Views.RsdView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:assets="clr-namespace:ChromExplorer.Assets;assembly=ChromExplorer.Assets"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="900" Background="White">

    <UserControl.Resources>
        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,4">
            <TextBlock Text="RSD Calculation" FontSize="24" FontWeight="Bold" Foreground="#2D3E50"
                       VerticalAlignment="Center" DockPanel.Dock="Left"/>
            <Button Content="Clear All" Command="{Binding ClearAllCommand}" DockPanel.Dock="Right"
                    Width="90" Height="30" Background="#B03A2E" Foreground="White"
                    BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" HorizontalAlignment="Right">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </DockPanel>

        <TextBlock Grid.Row="1" Margin="0,0,0,14" FontSize="12" Foreground="#8898AA" TextWrapping="Wrap"
                   Text="Add a file's peak area from the chromatogram view (toolbar's &quot;Add to RSD&quot; button) and enter the Concentration. Add several files at the same concentration; %RSD is then calculated for each concentration from the mean and standard deviation of those files' areas (at least 2 files per concentration)."/>

        <!-- %RSD per Sample ID group -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="%RSD by Concentration" FontSize="15" FontWeight="SemiBold" Foreground="#2D3E50" Margin="12,10,12,4"/>

                <Grid Grid.Row="1">
                    <DataGrid ItemsSource="{Binding Summaries}" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" IsReadOnly="True"
                              HorizontalGridLinesBrush="#F0F0F0" BorderThickness="0" Background="Transparent"
                              RowHeight="34" FontSize="13" Margin="0,0,0,10"
                              ColumnHeaderStyle="{StaticResource GridHeaderStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Concentration" Binding="{Binding Concentration, TargetNullValue=(not entered)}" Width="140"/>
                            <DataGridTextColumn Header="N" Binding="{Binding Count}" Width="50"/>
                            <DataGridTextColumn Header="Mean Area" Binding="{Binding MeanArea, StringFormat=F0}" Width="120"/>
                            <DataGridTextColumn Header="Std Dev" Binding="{Binding StdDev, StringFormat=F2}" Width="120"/>
                            <DataGridTextColumn Header="%RSD" Binding="{Binding RsdPercent, StringFormat=F2}" Width="100"/>
                            <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="No files added yet." Foreground="#9AA7B4" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Summaries.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <!-- Raw queued entries -->
        <Border Grid.Row="3" Background="White" CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Queued Files" FontSize="15" FontWeight="SemiBold" Foreground="#2D3E50" Margin="12,10,12,4"/>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Entries}" AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" IsReadOnly="True"
                          HorizontalGridLinesBrush="#F0F0F0" BorderThickness="0" Background="Transparent"
                          RowHeight="34" FontSize="13" Margin="0,0,0,10"
                          ColumnHeaderStyle="{StaticResource GridHeaderStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding ID}" Width="40"/>
                        <DataGridTextColumn Header="Sample ID" Binding="{Binding SampleID}" Width="180"/>
                        <DataGridTextColumn Header="Concentration" Binding="{Binding Concentration, TargetNullValue=N/A}" Width="110"/>
                        <DataGridTextColumn Header="Area" Binding="{Binding Area, StringFormat=F0}" Width="100"/>
                        <DataGridTextColumn Header="File" Binding="{Binding FilePath}" Width="*"/>
                        <DataGridTextColumn Header="Added" Binding="{Binding InsertedDate}" Width="140"/>
                        <DataGridTemplateColumn Header="" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Remove"
                                            Command="{Binding DataContext.DeleteSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="8,2" Background="Transparent" Foreground="#B03A2E"
                                            BorderThickness="1" BorderBrush="#B03A2E" Cursor="Hand" FontSize="11"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Save / Open list — files go to a fixed folder (D:\RSD data), no save dialog -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Height="32" Width="32" MinHeight="0" MinWidth="0" Margin="0,0,5,0" Command="{Binding OpenFileCommand}"
                    ToolTip="Open list...">
                <Image Source="{assets:Asset MetroIcons/Open.png}" />
            </Button>
            <Button Height="32" Width="32" MinHeight="0" MinWidth="0" Margin="5,0" Command="{Binding SaveFileCommand}"
                    ToolTip="Save list (to D:\RSD data)">
                <Image Source="{assets:Asset MetroIcons/Save-02-WF.png}" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
