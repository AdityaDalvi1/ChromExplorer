<UserControl x:Class="ChromExplorer.Modules.Quan.Views.QuanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"  
             xmlns:prism="http://www.codeplex.com/prism" 
             xmlns:interactionRequest="clr-namespace:ChromExplorer.Infrastructure.InteractionRequest;assembly=ChromExplorer.Infrastructure"
             xmlns:xcdg="http://schemas.xceed.com/wpf/xaml/datagrid"
             xmlns:componentModel="clr-namespace:System.ComponentModel;assembly=WindowsBase"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:assets="clr-namespace:ChromExplorer.Assets;assembly=ChromExplorer.Assets"    
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="800" d:DataContext="{d:DesignData }">
    <UserControl.Resources>
        <xcdg:DataGridCollectionViewSource x:Key="PeaksSource" Source="{Binding Peaks}">
            <xcdg:DataGridCollectionViewSource.SortDescriptions>
                <componentModel:SortDescription PropertyName="ID" Direction="Ascending"/>

            </xcdg:DataGridCollectionViewSource.SortDescriptions>
        </xcdg:DataGridCollectionViewSource>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>
            <xcdg:DataGridControl x:Name="DataGridControl"
                                  ItemsSource="{Binding Source={StaticResource PeaksSource}}"
                                  SelectedItem="{Binding SelectedItem}"
                                  AutoCreateColumns="False" Margin="5"
                                  ReadOnly="True"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <xcdg:DataGridControl.View>
                    <xcdg:TableflowView UseDefaultHeadersFooters="False">
                        <xcdg:TableflowView.FixedHeaders>
                            <DataTemplate>
                                <xcdg:ColumnManagerRow />
                            </DataTemplate>
                        </xcdg:TableflowView.FixedHeaders>
                    </xcdg:TableflowView>
                </xcdg:DataGridControl.View>
                <xcdg:DataGridControl.Columns>
                    <xcdg:Column FieldName="ID" Title="#" ReadOnly="True" Width="20"></xcdg:Column>
                    <xcdg:Column FieldName="SampleID" Title="Sample" ReadOnly="True" Width="60"/>
                    <xcdg:Column FieldName="SampleType" Title="Sample Type" ReadOnly="True" Width="90"/>
                    <xcdg:Column FieldName="ExpectedAmount" IsMainColumn="True" Title="Exp Amt" ReadOnly="True" Width="80">
                        <xcdg:Column.CellContentTemplate>
                            <DataTemplate>
                                <xctk:WatermarkTextBox Text="{Binding Path=.}" Watermark="N/A" IsReadOnly="True" IsHitTestVisible="False" Focusable="False" IsTabStop="False"/>
                            </DataTemplate>
                        </xcdg:Column.CellContentTemplate>
                    </xcdg:Column>
                    <xcdg:Column FieldName="Area" IsMainColumn="True" Title="Area" ReadOnly="True" Width="80">
                        <xcdg:Column.CellContentTemplate>
                            <DataTemplate>
                                <xctk:WatermarkTextBox Text="{Binding Path=., StringFormat={}{0:0}}" Watermark="N/A" IsReadOnly="True" IsHitTestVisible="False" Focusable="False" IsTabStop="False" />
                            </DataTemplate>
                        </xcdg:Column.CellContentTemplate>
                    </xcdg:Column>
                    <xcdg:Column FieldName="CalculatedAmount" IsMainColumn="True" Title="Calc Amt" ReadOnly="True" Width="80">
                        <xcdg:Column.CellContentTemplate>
                            <DataTemplate>
                                <xctk:WatermarkTextBox Text="{Binding Path=., StringFormat={}{0:0.000}}" Watermark="N/A" IsReadOnly="True" IsHitTestVisible="False" Focusable="False" IsTabStop="False" />
                            </DataTemplate>
                        </xcdg:Column.CellContentTemplate>
                    </xcdg:Column>
                    <xcdg:Column FieldName="RecoveryPercent" IsMainColumn="True" Title="%Recovery" ReadOnly="True" Width="70">
                        <xcdg:Column.CellContentTemplate>
                            <DataTemplate>
                                <xctk:WatermarkTextBox Text="{Binding Path=., StringFormat={}{0:0.00}}" Watermark="N/A" IsReadOnly="True" IsHitTestVisible="False" Focusable="False" IsTabStop="False" />
                            </DataTemplate>
                        </xcdg:Column.CellContentTemplate>
                    </xcdg:Column>
                    <xcdg:Column FieldName="Difference" IsMainColumn="True" Title="%Difference" ReadOnly="True" Width="60">
                        <xcdg:Column.CellContentTemplate>
                            <DataTemplate>
                                <xctk:WatermarkTextBox Text="{Binding Path=., StringFormat={}{0:0.00}}" Watermark="N/A" IsReadOnly="True" IsHitTestVisible="False" Focusable="False" IsTabStop="False" />
                            </DataTemplate>
                        </xcdg:Column.CellContentTemplate>
                    </xcdg:Column>
                    <xcdg:Column FieldName="FilePath" IsMainColumn="True" Title="File" ReadOnly="True" Width="*"/>
                </xcdg:DataGridControl.Columns>
            </xcdg:DataGridControl>
            <Grid  Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <Button Height="32" Width="32" MinHeight="0" MinWidth="0" Margin="5" Command="{Binding NewFileCommand}"
                        ToolTip="Start a new list">
                        <TextBlock Text="+" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0"/>
                    </Button>
                    <Button Height="32" Width="32" MinHeight="0" MinWidth="0" Margin="5" Command="{Binding OpenFileCommand}"
                        CommandParameter="{Binding SelectedItem, ElementName=DataGridControl}"
                        ToolTip="Open list...">
                        <Image Source="{assets:Asset MetroIcons/Open.png}" />
                    </Button>
                    <Button Height="32" Width="32" MinHeight="0" MinWidth="0" Margin="5" Command="{Binding SaveFileCommand}" 
                        CommandParameter="{Binding SelectedItem, ElementName=DataGridControl}"
                        ToolTip="Save list...">
                        <Image Source="{assets:Asset MetroIcons/Save-02-WF.png}" />
                    </Button>
                    <Button Height="32" Width="32" MinHeight="0" MinWidth="0" Margin="5" Command="{Binding ExportFileCommand}" 
                        CommandParameter="{Binding SelectedItem, ElementName=DataGridControl}"
                        ToolTip="Export to csv...">
                        <Image Source="{assets:Asset MetroIcons/Export-02-WF.png}" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Column="1">
                    <Button Height="32" Width="80" MinHeight="0" MinWidth="0" Margin="5" Command="{Binding CalculateCommand}" 
                        CommandParameter="{Binding SelectedItem, ElementName=DataGridControl}"
                        ToolTip="Calculate">
                        Calculate
                    </Button>
                    <CheckBox Margin="10,0,0,0" VerticalAlignment="Center" Content="Show Error Bars" IsChecked="{Binding IsErrorBarsEnabled, Mode=TwoWay}" />
                </StackPanel>
            </Grid>

        </Grid>
        <oxy:PlotView Grid.Row="0" Grid.Column="1" Margin="3" Model="{Binding Model}"></oxy:PlotView>

    </Grid>
</UserControl>
