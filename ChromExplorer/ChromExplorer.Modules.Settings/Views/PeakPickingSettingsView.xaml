<UserControl x:Class="ChromExplorer.Modules.Settings.Views.PeakPickingSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:System="clr-namespace:System;assembly=mscorlib" 
             xmlns:Interfaces="clr-namespace:ChromExplorer.Infrastructure.Interfaces;assembly=ChromExplorer.Infrastructure"
             xmlns:markers="clr-namespace:ChromExplorer.Plotter.Markers;assembly=ChromExplorer.Plotter"
             mc:Ignorable="d" 
             >
    <UserControl.Resources>
        <ResourceDictionary>
            <ObjectDataProvider x:Key="thresholdTypes"
                MethodName="GetValues" ObjectType="{x:Type System:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="Interfaces:ThresholdTypes"/>
                </ObjectDataProvider.MethodParameters>

            </ObjectDataProvider>

            <ObjectDataProvider x:Key="analyzers"
                MethodName="GetValues" ObjectType="{x:Type System:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="Interfaces:PeakAnalyzers"/>
                </ObjectDataProvider.MethodParameters>

            </ObjectDataProvider>

            <ObjectDataProvider x:Key="orientations"
                MethodName="GetValues" ObjectType="{x:Type System:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="markers:MarkerOrientation"/>
                </ObjectDataProvider.MethodParameters>

            </ObjectDataProvider>

            <ObjectDataProvider x:Key="placements"
                MethodName="GetValues" ObjectType="{x:Type System:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="markers:MarkerPlacement"/>
                </ObjectDataProvider.MethodParameters>

            </ObjectDataProvider>

        </ResourceDictionary>
    </UserControl.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10*"></ColumnDefinition>
                    <ColumnDefinition Width="10"></ColumnDefinition>
                    <ColumnDefinition Width="10*"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource headerBarBG}" BorderBrush="AntiqueWhite" BorderThickness="3" CornerRadius="6">
                    <TextBlock Foreground="White" FontFamily="Tahoma" FontWeight="Bold" HorizontalAlignment="Center" Margin="5">General</TextBlock>
                </Border>

                <Grid Grid.Row="1" Grid.RowSpan="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="5,5,5,5">Method</TextBlock>
                    <TextBlock Margin="5,5,5,5" Grid.Row="1">Threshold Type</TextBlock>
                    <TextBlock Margin="5,5,5,5" Grid.Row="2">Threshold</TextBlock>
                
                    <ComboBox Margin="5" SelectedItem="{Binding Current}" ItemsSource="{Binding Algorithms}" Grid.Column="1" HorizontalContentAlignment="Stretch">
                        <ComboBox.Resources>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"></Setter>
                            </Style>
                        </ComboBox.Resources>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding Tooltip}">
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Title}"></TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        
                    </ComboBox>
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="5,5,5,5" 
                              ItemsSource="{Binding Source={StaticResource thresholdTypes}}"
                              SelectedItem="{Binding ThresholdType}"
                    ></ComboBox>
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="5" Text="{Binding Threshold}"></TextBox>
            

                </Grid>

                <Border Grid.Row="2" Background="{StaticResource headerBarBG}" BorderBrush="AntiqueWhite" BorderThickness="3" CornerRadius="6">
                    <TextBlock Foreground="White" FontFamily="Tahoma" FontWeight="Bold" HorizontalAlignment="Center" Margin="5">Labels</TextBlock>
                </Border>

                <Grid Grid.Row="3" Grid.RowSpan="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>

                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="5,5,5,5">Peak Label Format</TextBlock>
                    <TextBlock Grid.Row="1" Margin="5,5,5,5">Peak Label Orientation</TextBlock>
                    <TextBlock Grid.Row="2" Margin="5,5,5,5">Peak Label Placement</TextBlock>
           
                    
                    <TextBox Grid.Column="1" Margin="5" Text="{Binding LabelFormat}"></TextBox>
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="5" 
                              ItemsSource="{Binding Source={StaticResource orientations}}"
                              SelectedItem="{Binding LabelOrientation}"></ComboBox>
                    <ComboBox Grid.Row="2" Grid.Column="1" Margin="5" ItemsSource="{Binding Source={StaticResource placements}}"
                              SelectedItem="{Binding LabelPlacement}"></ComboBox>


                </Grid>

                <Border Grid.Column="2"  Background="{StaticResource headerBarBG}" BorderBrush="AntiqueWhite" BorderThickness="3" CornerRadius="6">
                    <TextBlock Foreground="White" FontFamily="Tahoma" FontWeight="Bold" HorizontalAlignment="Center" Margin="5">Method Settings</TextBlock>
                </Border>

                <ContentControl Grid.Column="2" Grid.Row="1" Content="{Binding Current.ConfigView}" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch">
                    
                </ContentControl>

                <Border Grid.Column="2" Grid.Row="2"  Background="{StaticResource headerBarBG}" BorderBrush="AntiqueWhite" BorderThickness="3" CornerRadius="6" VerticalAlignment="Top">
                    <TextBlock Foreground="White" FontFamily="Tahoma" FontWeight="Bold" HorizontalAlignment="Center" Margin="5">Analyzer</TextBlock>
                </Border>

                <Grid Grid.Column="2" Grid.Row="3" Grid.RowSpan="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="5,5,5,5">Analyzer</TextBlock>
                   

                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="5,5,5,5" 
                              ItemsSource="{Binding Source={StaticResource analyzers}}"
                              SelectedItem="{Binding Analyzer}"
                    ></ComboBox>


                </Grid>

            </Grid>


        </ScrollViewer>
        <StackPanel Grid.Row="1" HorizontalAlignment="Right">
            <Button Margin="5" Command="{Binding ApplyCommand}">Apply</Button>
        </StackPanel>
    </Grid>
</UserControl>
