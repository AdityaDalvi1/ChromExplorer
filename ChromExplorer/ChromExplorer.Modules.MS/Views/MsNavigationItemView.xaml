<UserControl x:Class="ChromExplorer.Modules.Ms.Views.MsNavigationItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ChromExplorer.Modules.Ms.Views"
             xmlns:assets="clr-namespace:ChromExplorer.Assets;assembly=ChromExplorer.Assets"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <ToggleButton Margin="2" x:Name="NavigateToMsSettingsView" Click="NavigateClick" ToolTip="Syringe Control">
            <Image Width="32" Height="32" Source="{assets:Asset MetroIcons/Setting_2-WF.png}"></Image>
        </ToggleButton>
    </Grid>
</UserControl>
