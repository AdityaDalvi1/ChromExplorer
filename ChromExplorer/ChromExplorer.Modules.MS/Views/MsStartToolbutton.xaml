<UserControl x:Class="ChromExplorer.Modules.Ms.Views.MsStartToolbutton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ChromExplorer.Modules.Ms.Views"
             xmlns:assets="clr-namespace:ChromExplorer.Assets;assembly=ChromExplorer.Assets"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <ToggleButton Margin="2" x:Name="NavigateToSettingsView" ToolTip="Start Syringe" Click="BtnClick">
        <Image Width="32" Height="32" Source="{assets:Asset MetroIcons/Media Play1-WF.png}"></Image>
    </ToggleButton>
</UserControl>
