<Window x:Class="ChromExplorer.Modules.Viewer.Views.MethodReportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Method Report Preview" Height="760" Width="700" MinHeight="420" MinWidth="500"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2D3E50" Padding="18,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Method Report Preview" FontSize="17" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text="Current instrument method — Analysis Type, General, Ion Source, Overrides" FontSize="12" Foreground="#C7D3E0" Margin="14,2,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="#E4E9EF">
            <FlowDocumentScrollViewer x:Name="docViewer" Margin="20"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      IsToolBarVisible="False"/>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#DDE3EA" BorderThickness="0,1,0,0" Padding="18,12">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="This preview reflects the same content that will be saved as the PDF." FontSize="11.5" Foreground="#8898AA" VerticalAlignment="Center"/>

                <Button DockPanel.Dock="Right" x:Name="btnSave" Content="Save Report" Click="BtnSave_Click"
                        Width="140" Height="36" Cursor="Hand"
                        Background="#2D3E50" Foreground="White" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button DockPanel.Dock="Right" x:Name="btnDiscard" Content="Discard" Click="BtnDiscard_Click"
                        Width="110" Height="36" Margin="0,0,10,0" Cursor="Hand"
                        Background="Transparent" Foreground="#B03A2E" BorderBrush="#B03A2E" BorderThickness="1.2">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </DockPanel>
        </Border>
    </Grid>
</Window>
