<Window x:Class="ChromExplorer.Modules.Viewer.Views.ReportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Report Preview" Height="820" Width="760" MinHeight="420" MinWidth="500"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2D3E50" Padding="18,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Report Preview" FontSize="17" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtSummary" Text="Shown in-app, exactly as it will be generated" FontSize="12" Foreground="#C7D3E0" Margin="14,2,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border x:Name="fileListPanel" Grid.Row="1" Background="#F4F6F9" BorderBrush="#DDE3EA" BorderThickness="0,0,0,1" Padding="18,10">
            <StackPanel>
                <TextBlock Text="Files included in this report — click ✕ to remove one:" FontSize="11.5" FontWeight="SemiBold" Foreground="#5A6B7C" Margin="0,0,0,6"/>
                <ItemsControl x:Name="fileListControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="#C7D3E0" BorderThickness="1" CornerRadius="12" Margin="0,0,8,8" Padding="10,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding FileName}" FontSize="11.5" Foreground="#2D3E50" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Content="✕" Width="18" Height="18" Padding="0" FontSize="10" FontWeight="Bold" Cursor="Hand"
                                            Background="Transparent" BorderThickness="0" Foreground="#B03A2E"
                                            Click="BtnRemoveEntry_Click" Tag="{Binding}"
                                            ToolTip="Remove this file's results from the report"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border x:Name="statusBanner" Grid.Row="2" Background="#FFF6E5" BorderBrush="#F0D48A" BorderThickness="0,0,0,1"
                Padding="18,10" Visibility="Collapsed">
            <TextBlock x:Name="txtStatusBanner" FontSize="12.5" Foreground="#7A5B00" TextWrapping="Wrap"/>
        </Border>

        <Border Grid.Row="3" Background="#E4E9EF">
            <FlowDocumentScrollViewer x:Name="docViewer" Margin="20"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      IsToolBarVisible="False"/>
        </Border>

        <Border Grid.Row="4" Background="White" BorderBrush="#DDE3EA" BorderThickness="0,1,0,0" Padding="18,12">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="This preview reflects the same content that will be saved as the PDF." FontSize="11.5" Foreground="#8898AA" VerticalAlignment="Center"/>

                <Button DockPanel.Dock="Right" x:Name="btnSave" Content="Send for Review" Click="BtnSave_Click"
                        Width="140" Height="36" Cursor="Hand"
                        Background="#2D3E50" Foreground="White" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button DockPanel.Dock="Right" x:Name="btnDiscard" Content="Discard" Click="BtnDiscard_Click"
                        Width="110" Height="36" Margin="0,0,10,0" Cursor="Hand"
                        Background="Transparent" Foreground="#B03A2E" BorderBrush="#B03A2E" BorderThickness="1.2">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </DockPanel>
        </Border>
    </Grid>
</Window>
