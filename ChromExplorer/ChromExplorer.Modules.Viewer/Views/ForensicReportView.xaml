<UserControl x:Class="ChromExplorer.Modules.Viewer.Views.ForensicReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="CellLabelStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style x:Key="CellValueStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="0,1,1,1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RowLabelText" TargetType="TextBlock">
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ReadOnlyFieldTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FieldTextBoxStyle}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="#F4F6F8"/>
            <Setter Property="Foreground" Value="#555555"/>
        </Style>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1F6FB2"/>
            <Setter Property="Margin" Value="0,22,0,10"/>
        </Style>
    </UserControl.Resources>

    <!-- Overlay backdrop, dims the tabs/content behind while this form is shown in OverContentRegion -->
    <Grid Background="#8A2D3E50">
        <Border Background="White" CornerRadius="8"
                MaxWidth="940" MaxHeight="820"
                Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.35" Color="Black"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="#2D3E50" Padding="28,16" CornerRadius="8,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Forensic Report" FontSize="20" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Complete the sample details and results below to generate the forensic report" FontSize="12" Foreground="#C9D3DC" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="btnClose" Content="&#10005;" Click="BtnClose_Click"
                                Width="30" Height="30" FontSize="13" Cursor="Hand"
                                Background="Transparent" Foreground="White" BorderThickness="0" VerticalAlignment="Top"/>
                    </Grid>
                </Border>

                <!-- Scrollable body -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="32,24,32,24" HorizontalAlignment="Stretch">

                        <!-- Report & Sample Information -->
                        <TextBlock Text="Report &amp; Sample Information" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CellLabelStyle}">
                                <TextBlock Text="Field" Style="{StaticResource RowLabelText}" FontWeight="Bold"/>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CellValueStyle}">
                                <TextBlock Text="Details" Style="{StaticResource RowLabelText}" FontWeight="Bold"/>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CellLabelStyle}">
                                <TextBlock Text="Report No." Style="{StaticResource RowLabelText}"/>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CellValueStyle}">
                                <TextBox x:Name="txtReportNo" Style="{StaticResource ReadOnlyFieldTextBoxStyle}"/>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CellLabelStyle}">
                                <TextBlock Text="Case No." Style="{StaticResource RowLabelText}"/>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource CellValueStyle}">
                                <TextBox x:Name="txtCaseNo" Style="{StaticResource FieldTextBoxStyle}"/>
                            </Border>

                            <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource CellLabelStyle}">
                                <TextBlock Text="Sample Description" Style="{StaticResource RowLabelText}"/>
                            </Border>
                            <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource CellValueStyle}">
                                <TextBox x:Name="txtSampleDescription" Style="{StaticResource FieldTextBoxStyle}"/>
                            </Border>

                            <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource CellLabelStyle}">
                                <TextBlock Text="Received Date" Style="{StaticResource RowLabelText}"/>
                            </Border>
                            <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource CellValueStyle}">
                                <TextBox x:Name="txtReceivedDate" Style="{StaticResource ReadOnlyFieldTextBoxStyle}"/>
                            </Border>

                            <Border Grid.Row="5" Grid.Column="0" Style="{StaticResource CellLabelStyle}">
                                <TextBlock Text="Analysis Date" Style="{StaticResource RowLabelText}"/>
                            </Border>
                            <Border Grid.Row="5" Grid.Column="1" Style="{StaticResource CellValueStyle}">
                                <TextBox x:Name="txtAnalysisDate" Style="{StaticResource ReadOnlyFieldTextBoxStyle}"/>
                            </Border>

                            <Border Grid.Row="6" Grid.Column="0" Style="{StaticResource CellLabelStyle}">
                                <TextBlock Text="Analyst" Style="{StaticResource RowLabelText}"/>
                            </Border>
                            <Border Grid.Row="6" Grid.Column="1" Style="{StaticResource CellValueStyle}">
                                <TextBox x:Name="txtAnalyst" Style="{StaticResource ReadOnlyFieldTextBoxStyle}"/>
                            </Border>
                        </Grid>

                        <!-- Results -->
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Results" Style="{StaticResource SectionHeaderStyle}"/>
                            <Button Grid.Column="1" x:Name="btnAddResultRow" Content="+ Add Row" Click="BtnAddResultRow_Click"
                                    Padding="14,6" Background="White" Foreground="#1F6FB2" BorderBrush="#1F6FB2" BorderThickness="1"
                                    Cursor="Hand" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,10,0,0"/>
                        </Grid>

                        <DataGrid x:Name="dgResults" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="True"
                                  HeadersVisibility="Column" GridLinesVisibility="All" RowHeight="36"
                                  BorderBrush="#333333" BorderThickness="1" HorizontalScrollBarVisibility="Disabled"
                                  HorizontalGridLinesBrush="#333333" VerticalGridLinesBrush="#333333" Background="White">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="#222222"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="BorderBrush" Value="#333333"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Target" Binding="{Binding Target, UpdateSourceTrigger=PropertyChanged}" Width="1.3*"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status, UpdateSourceTrigger=PropertyChanged}" Width="1*"/>
                                <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence, UpdateSourceTrigger=PropertyChanged}" Width="1*"/>
                                <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}" Width="1.8*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Conclusion -->
                        <TextBlock Text="Conclusion" Style="{StaticResource SectionHeaderStyle}"/>
                        <Border BorderBrush="#333333" BorderThickness="1" Background="White">
                            <TextBox x:Name="txtConclusion" AcceptsReturn="True" TextWrapping="Wrap"
                                     BorderThickness="0" Background="Transparent" Padding="10,10"
                                     Height="90" VerticalScrollBarVisibility="Auto"/>
                        </Border>

                        <!-- Optional Attachments -->
                        <TextBlock Text="Optional Attachments (Print only if selected)" Style="{StaticResource SectionHeaderStyle}"/>
                        <Border BorderBrush="#333333" BorderThickness="1" Background="White" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" x:Name="chkMassSpectrum" Content="Mass Spectrum" FontSize="13" Foreground="#222222" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1" x:Name="chkLibrarySearch" Content="Library Search Results" FontSize="13" Foreground="#222222" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="2" x:Name="chkChromatogram" Content="Chromatogram" FontSize="13" Foreground="#222222" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Signatures -->
                        <Grid Margin="0,26,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="Analyst Signature:" FontSize="13" Foreground="#222222" VerticalAlignment="Bottom" Margin="0,0,10,4"/>
                                <Border BorderBrush="#333333" BorderThickness="0,0,0,1" Width="200" VerticalAlignment="Bottom">
                                    <TextBox x:Name="txtAnalystSignature" BorderThickness="0" Background="Transparent" Padding="2,4" FontSize="13"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <TextBlock Text="Reviewer:" FontSize="13" Foreground="#222222" VerticalAlignment="Bottom" Margin="0,0,10,4"/>
                                <Border BorderBrush="#333333" BorderThickness="0,0,0,1" Width="200" VerticalAlignment="Bottom">
                                    <TextBox x:Name="txtReviewer" BorderThickness="0" Background="Transparent" Padding="2,4" FontSize="13"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <Border Grid.Row="2" Background="White" BorderBrush="#D6DBE1" BorderThickness="0,1,0,0" Padding="32,14" CornerRadius="0,0,8,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="All fields are saved only when the report is generated." FontSize="12" Foreground="#8898AA" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" x:Name="btnGenerateReport" Content="Generate Report" Click="BtnGenerateReport_Click"
                                Height="42" Width="180" FontSize="14" FontWeight="SemiBold" Cursor="Hand"
                                Background="#2D3E50" Foreground="White" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
