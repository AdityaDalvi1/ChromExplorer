<interactionRequest:InteractionDialogBase x:Class="ChromExplorer.Modules.Viewer.Views.RsdInfoView"
                                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                                          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                                          xmlns:local="clr-namespace:ChromExplorer.Modules.Viewer.Views"
                                          xmlns:interactionRequest="clr-namespace:ChromExplorer.Infrastructure.InteractionRequest;assembly=ChromExplorer.Infrastructure"
                                          xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
                                          xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions"
                                          xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
                                          mc:Ignorable="d">
    <Grid Background="#A9CECECE">

        <Border Background="White" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="400"
                MinHeight="130" MinWidth="250" MaxHeight="230">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="25" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="40" />
                </Grid.RowDefinitions>
                <Rectangle Stroke="Black" StrokeThickness="1" Margin="0" Grid.RowSpan="3">
                    <Rectangle.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="20" RenderingBias="Quality" Direction="0" />
                    </Rectangle.Effect>
                </Rectangle>

                <Rectangle Fill="#FFA7C1DC" Margin="1,1,1,0" />
                <TextBlock Margin="6,0" Text="{Binding Path=Title}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" FontSize="16" />

                <!-- Deliberately just Sample ID (editable, so the same value can be typed for
                     every replicate injection of one sample — RSD groups by this) and the
                     already-computed peak Area (read-only). No ExpectedAmount/SampleType like
                     QuanInfoView — RSD is a precision check across replicates, not a calibration. -->
                <ScrollViewer Grid.Row="1" Margin="6" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <TextBlock Margin="5">Sample ID</TextBlock>
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="5" Text="{Binding SampleID, Mode=OneWay}" IsReadOnly="True"></TextBox>
                        <TextBlock Margin="5" Grid.Row="1" Grid.Column="0">Concentration</TextBlock>
                        <xctk:DoubleUpDown Grid.Row="1" Grid.Column="1" Margin="5" Value="{Binding Concentration}" Watermark="Enter concentration" Minimum="0"></xctk:DoubleUpDown>
                        <TextBlock Margin="5" Grid.Row="2" Grid.Column="0">Area</TextBlock>
                        <xctk:DoubleUpDown Grid.Row="2" Grid.Column="1" Margin="5" Value="{Binding Area}" Watermark="N/A" FormatString="F0" IsReadOnly="True"></xctk:DoubleUpDown>
                    </Grid>
                </ScrollViewer>

                <Rectangle Fill="#FFF1F1F1" Margin="1,0,1,1" Grid.Row="2" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="2">
                    <Button Content="OK" Width="75" Height="23" Margin="11,0">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Click">
                                <ei:ChangePropertyAction PropertyName="Confirmed" TargetObject="{Binding}" Value="True" />
                                <ei:CallMethodAction
                                    TargetObject="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=interactionRequest:InteractionDialogBase, AncestorLevel=1}}"
                                    MethodName="Close" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </Button>

                    <Button Content="Cancel" Width="75" Height="23" Margin="11,0">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Click">
                                <ei:CallMethodAction
                                    TargetObject="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=interactionRequest:InteractionDialogBase, AncestorLevel=1}}"
                                    MethodName="Close" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </Button>

                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</interactionRequest:InteractionDialogBase>
