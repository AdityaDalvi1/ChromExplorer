<UserControl x:Class="ChromExplorer.Modules.Viewer.Views.SpectrumPlotView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:cp="clr-namespace:ChromExplorer.Plotter;assembly=ChromExplorer.Plotter" 
			 xmlns:ca="clr-namespace:ChromExplorer.Assets;assembly=ChromExplorer.Assets"
			 xmlns:infrastructure="clr-namespace:ChromExplorer.Infrastructure;assembly=ChromExplorer.Infrastructure"
			 xmlns:converters="clr-namespace:ChromExplorer.Infrastructure.Converters;assembly=ChromExplorer.Infrastructure"
			 mc:Ignorable="d" 
			 d:DesignHeight="300" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <converters:SpectrumTypeToVisibilityConverter x:Key="typeToVisibility" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>

            <Grid Margin="45, 0, 0, 10" Background="LightBlue">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <StackPanel  Background="LightBlue" Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Width="50" Margin="3" Text="{Binding Chromatogram.CurrentSpectrum.Type}"></TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5,0,0,0">
                        <TextBlock Margin="10, 3, 3, 3">Index:</TextBlock>
                        <TextBlock Width="45" Margin="3" Text="{Binding Chromatogram.CurrentSpectrum.Index}"></TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="5,0,0,0">
                        <TextBlock Margin="10, 3, 3, 3">IT (sec):</TextBlock>
                        <TextBlock Width="60" Margin="3" Text="{Binding Chromatogram.CurrentSpectrum.InjectionTime, StringFormat={}{0:0.###}}"></TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="5,0,0,0">
                        <TextBlock Margin="10, 3, 3, 3">R.Time:</TextBlock>
                        <TextBlock Width="60" Margin="3" Text="{Binding Chromatogram.CurrentSpectrum.RetentionTime, StringFormat={}{0:0.0}}"></TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="5,0,0,0" Visibility="{Binding Chromatogram.CurrentSpectrum.Type, Converter={StaticResource typeToVisibility}}">
                        <TextBlock Margin="10, 3, 3, 3">Parent</TextBlock>
                        <TextBlock Width="80" Margin="3" Text="{Binding Chromatogram.CurrentSpectrum.ParentIon, StringFormat={}{0:0.00}}"></TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="5,0,0,0">
                        <TextBlock Margin="10, 3, 3, 3">TIC:</TextBlock>
                        <TextBlock Margin="3" Text="{Binding Chromatogram.CurrentSpectrum.TIC, StringFormat={}{0:0.00}}"></TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="5,0,0,0">
                        <TextBlock Margin="10, 3, 3, 3">Timestamp:</TextBlock>
                        <TextBlock Margin="3" Text="{Binding Chromatogram.CurrentSpectrum.TimestampStr}"></TextBlock>
                    </StackPanel>

                </StackPanel>
                <Grid Grid.Column="2">
                    <StackPanel Orientation="Horizontal">

                        <Menu Background="LightBlue">
                            <MenuItem Header="Search">
                                <MenuItem Header="NIST - New" Command="{Binding NistLibrarySearchCommand}" ></MenuItem>
                                <MenuItem Header="NIST - Append" Command="{Binding NistLibrarySearchCommand }" CommandParameter="APPEND"></MenuItem>
                            </MenuItem>
                            <MenuItem Header="Export">
                                <MenuItem Header="Spectrum..." Command="{Binding ExportSpectrumCommand}"></MenuItem>
                                <MenuItem Header="Peak List..."  Command="{Binding ExportPeakListCommand}"></MenuItem>
                                <MenuItem Header="NIST Text..."  Command="{Binding ExportNistTextCommand}"></MenuItem>
                                <Separator></Separator>
                                <MenuItem Header="Copy Mascot (Exact Mass)" Command="{Binding CopyMascotCommand}" CommandParameter="true"></MenuItem>
                                <MenuItem Header="Copy Mascot (Nominal Mass)" Command="{Binding CopyMascotCommand}" CommandParameter="false"></MenuItem>
                                <MenuItem Header="Copy Wiley Peak List" Command="{Binding CopyWileyCommand}" CommandParameter="false"></MenuItem>
                            </MenuItem>
                        </Menu>
                    </StackPanel>

                </Grid>
            </Grid>

            <cp:SimplePlotter Name="spectrumPlotter" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Row="1" IsSelectEnabled="False"
							  IsMultiSelectEnabled="{Binding MultiSelectEnabled}"
							  DataSource="{Binding Chromatogram.CurrentSpectrum.Points}" Margin="15, 0, 0, 10"
							  SelectedIndexes="{Binding Chromatogram.SelectedSpectrumIndexes, Mode=TwoWay}"
							  Markers="{Binding Markers}"
							  SelectionLimit="100000"
							  Visible="{Binding Visible, Mode=TwoWay}"
							  ></cp:SimplePlotter>
            <Grid Grid.Row="1">
                <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="50,3,0,0" CornerRadius="4" BorderBrush="LightBlue"
						BorderThickness="2">
                    <Expander Background="LightBlue" IsExpanded="True">
                        <StackPanel Orientation="Horizontal" Background="LightBlue">

                            <ToggleButton Name="autoScaleButton" Height="24" Width="24" MinHeight="0" MinWidth="0" Margin="3" IsChecked="{Binding MultiSelectEnabled}"
										  ToolTip="Toggle Select/Zoom" Style="{DynamicResource ToolbarToggleButtonStyle}">

                                <Image Width="16" Height="16" Source="{ca:Asset MetroIcons/Small/Selection-Modes.png}"></Image>
                            </ToggleButton>
                            <Button  Height="24" Width="24" MinHeight="0" MinWidth="0" Margin="3" Command="{Binding ClearSelectionCommand}"
									 ToolTip="Clear selection">
                                <Image Width="16" Height="16" Source="{ca:Asset MetroIcons/Small/Clean.png}"></Image>
                            </Button>
                        </StackPanel>
                    </Expander>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
