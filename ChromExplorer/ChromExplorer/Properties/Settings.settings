      <Value Profile="(Default)">25</Value>
    </Setting>
    <Setting Name="RemoveBaseline" Type="System.Boolean" Scope="User">
      <Value Profile="(Default)">True</Value>
    </Setting>
    <Setting Name="NoiseFilterLevel" Type="System.Double" Scope="User">
      <Value Profile="(Default)">3</Value>
    </Setting>
    <Setting Name="NormalizeByIT" Type="System.Boolean" Scope="User">
      <Value Profile="(Default)">True</Value>
