<Window x:Class="ChromExplorer.Shell"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://www.codeplex.com/prism" 
        xmlns:inf="clr-namespace:ChromExplorer.Infrastructure;assembly=ChromExplorer.Infrastructure" 
        xmlns:Controls="clr-namespace:ChromExplorer.Controls" xmlns:ChromExplorer="clr-namespace:ChromExplorer"
        Title="{x:Static ChromExplorer:CEVersionInfo.ProgramTitle}" Height="720" Width="1152"
        Closing="Shell_Closing">
    <Window.Background>
        <ImageBrush ImageSource="Resources/dna_bg_r.png"  Stretch="UniformToFill"/>
    </Window.Background>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
        </Grid.ColumnDefinitions>



        <Expander IsExpanded="True" Grid.ColumnSpan="3">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"></ColumnDefinition>
                    <ColumnDefinition Width="6*"></ColumnDefinition>
                    <ColumnDefinition Width="2*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Controls:RoundedBox Grid.Column="0" Margin="0,0,5,0"/>
                <Controls:RoundedBox Grid.Column="1" />
                <Controls:RoundedBox Grid.Column="2" Margin="5,0,0,0"/>

                <ItemsControl x:Name="LeftToolbar" Grid.Column="0" prism:RegionManager.RegionName="{x:Static inf:RegionNames.LeftToolBarRegion}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <ItemsControl x:Name="MainToolbar" Grid.Column="1" prism:RegionManager.RegionName="{x:Static inf:RegionNames.ToolBarRegion}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <ItemsControl x:Name="RightToolbar" Grid.Column="2" prism:RegionManager.RegionName="{x:Static inf:RegionNames.RightToolBarRegion}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

            </Grid>
        </Expander>
        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="10,10,10,10" >
            <ContentControl prism:RegionManager.RegionName="{x:Static inf:RegionNames.MainContentArea}">
                <ContentControl.Template>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Controls:RoundedBox />
                            <ContentPresenter Margin="5" Content="{TemplateBinding Content}" />
                        </Grid>
                    </ControlTemplate>
                </ContentControl.Template>
            </ContentControl>
        </Grid>
        
        

        <!--
        <Grid Grid.Row="1" Grid.ColumnSpan="1" Grid.Column="2" Margin="0, 10, 10, 10"  >
            <ContentControl prism:RegionManager.RegionName="{x:Static inf:RegionNames.InfoRegion}">
                <ContentControl.Template>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Controls:RoundedBox />
                            <ContentPresenter Margin="5" Content="{TemplateBinding Content}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasContent" Value="false">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ContentControl.Template>
            </ContentControl>
        </Grid>
-->
        
        
        <Grid Grid.Row="2" Grid.ColumnSpan="3" >
            <Expander IsExpanded="True">
                <ContentControl prism:RegionManager.RegionName="{x:Static inf:RegionNames.StatusBarRegion}"  Margin="5,5,5,5" >
                <ContentControl.Template>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Controls:RoundedBox />
                            <ContentPresenter Margin="5" Content="{TemplateBinding Content}" />
                        </Grid>
                    </ControlTemplate>
                </ContentControl.Template>
            </ContentControl>
            </Expander>
        </Grid>

        <!-- Grid.Column="1" Grid.Row="1" Grid.RowSpan="3" Grid.ColumnSpan="3"-->
        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="10,0,10,0">
            <Grid>
                <ContentControl Grid.Row="0" Grid.Column="0" prism:RegionManager.RegionName="{x:Static inf:RegionNames.OverContentRegion}" >
                    <ContentControl.Template>
                        <ControlTemplate TargetType="ContentControl">
                            <Grid>
                                <ContentPresenter Content="{TemplateBinding Content}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="HasContent" Value="false">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ContentControl.Template>
                </ContentControl>
            </Grid>
            <!--ContentControl prism:RegionManager.RegionName="{x:Static inf:RegionNames.OverContentRegion}" >
                <ContentControl.Template>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Controls:RoundedBox />
                            <ContentPresenter Margin="5" Content="{TemplateBinding Content}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasContent" Value="false">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ContentControl.Template>
            </ContentControl-->
        </Grid>

        <!-- Logged-in user indicator — sits inline in the status bar, just left of "Mem usage".
             Anchored to the status bar's own row (not a floating overlay) and vertically
             centered within it, so it lines up with "Mem usage" regardless of row height.
             Name + role shown as a small pill/badge instead of one plain run of text, so the
             role reads as a distinct label rather than looking like part of the name. -->
        <Border x:Name="loggedInUserBadge"
                Grid.Row="2" Grid.ColumnSpan="3"
                HorizontalAlignment="Left" VerticalAlignment="Center"
                Margin="140,0,0,0"
                Background="White" BorderBrush="#D8DEE4" BorderThickness="1"
                CornerRadius="12" Padding="10,3"
                IsHitTestVisible="False" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="txtLoggedInUser" FontSize="12" FontWeight="Bold" Foreground="#2D3E50" VerticalAlignment="Center"/>
                <Border x:Name="loggedInUserRoleBadge" Background="#6A1B9A" CornerRadius="8" Padding="7,1" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="txtLoggedInUserRole" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                </Border>
            </StackPanel>
        </Border>

    </Grid>
</Window>
