<Window x:Class="ChromExplorer.Modules.Auth.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChromExplorer Login" Height="560" Width="800"
        WindowStyle="None" ResizeMode="NoResize" 
        WindowStartupLocation="CenterScreen"
        Background="Transparent" AllowsTransparency="True">

    <Border Background="White" Width="360" Height="530" CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.25" Color="Black"/>
        </Border.Effect>

        <Grid Margin="40,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
                <TextBlock Text="ChromExplorer" FontSize="26" FontWeight="Bold" Foreground="#2D3E50" HorizontalAlignment="Center"/>
                <TextBlock Text="Please sign in to continue" FontSize="13" Foreground="#8898AA" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="USERNAME" FontSize="11" FontWeight="Bold" Foreground="#2D3E50" Margin="0,0,0,5"/>
                <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="5">
                    <TextBox x:Name="txtUser" 
         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
         BorderThickness="0" Background="Transparent" 
         VerticalContentAlignment="Center" Height="25" FontSize="14"/>
                </Border>

                <TextBlock Text="PASSWORD" FontSize="11" FontWeight="Bold" Foreground="#2D3E50" Margin="0,20,0,5"/>
                <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="txtPass" Grid.Column="0" BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center" Height="25" FontSize="14"/>
                        <TextBox x:Name="txtPassVisible" Grid.Column="0" BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center" Height="25" FontSize="14" Visibility="Collapsed"/>
                        <ToggleButton x:Name="btnTogglePass" Grid.Column="1" Content="👁"
                                      Width="24" Height="24" Background="Transparent" BorderThickness="0"
                                      Cursor="Hand" Click="TogglePasswordVisibility_Click"/>
                    </Grid>
                </Border>

                <TextBlock x:Name="lblMsg"
                           Text="{Binding ErrorMessage}"
                           Foreground="#E53935" FontSize="12" Margin="0,12,0,0"
                           HorizontalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,20,0,0">
                <Button Content="LOGIN" Click="BtnLogin_Click" 
                        Height="45" FontSize="14" FontWeight="SemiBold" Cursor="Hand"
                         Background="#E0E0E0"
  Foreground="#2D3E50" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="Exit Application" Click="BtnCancel_Click" 
                         Background="#E0E0E0"
  Foreground="#2D3E50" BorderThickness="0" 
                        Margin="0,15,0,0" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>