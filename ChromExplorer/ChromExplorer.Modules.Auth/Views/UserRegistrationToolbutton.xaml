<UserControl x:Class="ChromExplorer.Modules.Auth.Views.UserRegistrationToolbutton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ChromExplorer.Modules.Auth.Views"
            
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Button Margin="2" x:Name="OpenRegistrationForm" ToolTip="User Registration" Click="BtnClick">
        <Image Width="32" Height="32"
       Source="/ChromExplorer.Assets;component/MetroIcons/add-friend.png"/>
        <Button.ContextMenu>
            <ContextMenu x:Name="UserMenu">
                <MenuItem Header="View User" Click="ViewUser_Click"/>
                <MenuItem Header="View Assign Role" Click="ViewAssignRole_Click"/>
                <MenuItem Header="View Assign Rights" Click="ViewAssignRights_Click"/>
                <MenuItem Header="Review Saved Files" Click="ReviewSavedFiles_Click"/>
                <Separator/>
                <MenuItem Header="Change Password" Click="ChangePassword_Click"/>
                <MenuItem Header="Check User Password" Click="CheckUserPassword_Click"/>
            </ContextMenu>
        </Button.ContextMenu>
    </Button>
