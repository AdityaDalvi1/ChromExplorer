<UserControl x:Class="ChromExplorer.Modules.Auth.Views.AssignRights"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Overlay -->
        <Border Background="#99FFFFFF"
                Opacity="0.5"
                Grid.RowSpan="3"
                Grid.ColumnSpan="3" />

        <!-- Card -->
        <Grid Grid.Row="1" Grid.Column="1"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">

            <Border Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    Width="500"
                    Padding="20">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- TITLE -->
                        <TextBlock Text="Assign Rights"
               FontSize="20"
               FontWeight="Bold"
               VerticalAlignment="Center"/>

                        <!-- BACK BUTTON (RIGHT SIDE) -->
                        <Button Grid.Column="1"
            Content="← Back"
            Width="80"
            Height="30"
            Click="BackButton_Click"/>
                </Grid>
                <!-- USER DROPDOWN -->
                    

                    <!-- ROLE DROPDOWN -->
                    <TextBlock Grid.Row="3"
                               Text="Role*"
                               FontWeight="SemiBold"/>

                    <ComboBox x:Name="cmbRole"
                                Grid.Row="4"
                              ItemsSource="{Binding Roles}"
                              SelectedValue="{Binding SelectedRoleId, Mode=TwoWay}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Text"
                              
                              Height="30"
                              Margin="0,5,0,10"/>

                    <TextBlock Grid.Row="1"
                               Text="Menu Name*"
                               FontWeight="SemiBold"/>

                    <ComboBox x:Name="cmbMenu"
Grid.Row="2"
                              ItemsSource="{Binding Menu}"
                              SelectedValue="{Binding SelectedMenuId, Mode=TwoWay}"
                              SelectedValuePath="Id"
DisplayMemberPath="Text"
                              Height="30"
                              Margin="0,5,0,10"/>
                    <!-- ERROR -->
                    <TextBlock Grid.Row="5"
                               Text="{Binding ErrorMessage}"
                               Foreground="Red"
                               TextAlignment="Center"
                               Visibility="{Binding IsErrorVisible}"
                               Margin="0,5"/>

                    <!-- BUTTONS -->
                    <StackPanel Grid.Row="6"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,10,0,0">

                        <Button x:Name="btnSubmit"
                            Content="Submit"
                                Width="100"
                                Margin="5"
                                Click="SubmitButton_Click"/>

                        <Button x:Name="btnCancel"
                            Content="Cancel"
                                Width="100"
                                Margin="5"
                                Click="CancelButton_Click"/>
                    </StackPanel>

                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
