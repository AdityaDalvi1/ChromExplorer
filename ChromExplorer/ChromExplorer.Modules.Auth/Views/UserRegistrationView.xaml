<UserControl x:Class="ChromExplorer.Modules.Auth.Views.UserRegistrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="480" d:DesignWidth="640">

    <Grid>
        <!-- Make top and bottom areas only as big as needed -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- semi‑transparent overlay -->
        <Border Background="#99FFFFFF"
                Opacity="0.5"
                CornerRadius="12"
                Grid.RowSpan="3"
                Grid.ColumnSpan="3" />

        <!-- centered registration card -->
        <Grid Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Allow scrolling if the available height is too small -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border CornerRadius="12"
                        Background="White"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        Width="640"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid Margin="28,26">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- header: title + close button -->
                        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="txtTitle"
                                       Grid.Column="0"
                                       Text="User Registration"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#2D3E50"
                                       VerticalAlignment="Center"/>

                            <Button Grid.Column="1"
                                    Content="BACK"
                                    Width="34"
                                    Height="34"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"
                                    Click="BtnClose_Click"
                                    Background="Transparent"
                                    Foreground="#2D3E50"
                                    BorderThickness="0"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Row 1: Username (left) | Full Name (right) -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Username*"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#2D3E50" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Full Name*"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#2D3E50" Margin="0,0,0,6"/>

                        <Border Grid.Row="2" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1"
                                CornerRadius="6" Padding="10,8" Margin="0,0,0,18">
                            <TextBox x:Name="txtUsername"
                                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center" Height="34" FontSize="15"/>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="1"
                                CornerRadius="6" Padding="10,8" Margin="0,0,0,18">
                            <TextBox x:Name="txtFullName"
                                     Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center" Height="34" FontSize="15" PreviewTextInput="txtFullName_PreviewTextInput" />
                        </Border>

                        <!-- Row 2: Email (left) | Password (right) -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Email*"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#2D3E50" Margin="0,0,0,6"/>
                        <TextBlock x:Name="lblPassword" Grid.Row="3" Grid.Column="2" Text="Password*"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#2D3E50" Margin="0,0,0,6"/>

                        <Border Grid.Row="4" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1"
                                CornerRadius="6" Padding="10,8" Margin="0,0,0,18">
                            <TextBox x:Name="txtEmail"
                                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center" Height="34" FontSize="15"
                                     TextChanged="txtEmail_TextChanged"/>
                        </Border>
                        <Border x:Name="borderPassword" Grid.Row="4" Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="1"
                                CornerRadius="6" Padding="10,8" Margin="0,0,0,18">
                            <TextBox x:Name="txtPassword"
                                     Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center" Height="34" FontSize="15"/>
                        </Border>

                        <!-- Role: full width -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Text="Role*"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#2D3E50" Margin="0,0,0,6"/>
                        <ComboBox x:Name="cmbRole" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
                                  SelectedValue="{Binding SelectedRoleId, Mode=TwoWay}"
                                  SelectedValuePath="Tag" SelectedIndex="-1"
                                  Height="30" FontSize="15" Background="White" Foreground="#2D3E50"
                                  BorderBrush="#E0E0E0" BorderThickness="1" Padding="10,4"
                                  Margin="0,0,0,12">
                        </ComboBox>

                        <!-- Error message (only takes space when visible) -->
                        <Border x:Name="ErrorHost" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3"
                                Margin="0,0,0,10" VerticalAlignment="Top" Visibility="Collapsed">
                            <TextBlock x:Name="lblMsg"
                                       Text="{Binding ErrorMessage, UpdateSourceTrigger=PropertyChanged}"
                                       Foreground="#C62828" FontSize="13" FontWeight="SemiBold"
                                       TextWrapping="Wrap" VerticalAlignment="Center"
                                       HorizontalAlignment="Stretch" TextAlignment="Center"/>
                        </Border>

                        <!-- Buttons row -->
                        <Grid Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="btnSubmit"
                                    Grid.Column="0"
                                    Content="SUBMIT"
                                    Click="BtnSubmit_Click"
                                    Height="40"
                                    Margin="0,0,9,0"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"
                                    Background="#007ACC"
                                    Foreground="#2D3E50"
                                    BorderThickness="0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button x:Name="btnCancel"
                                    Grid.Column="1"
                                    Content="REST FORM"
                                    Click="BtnCancel_Click"
                                    Height="40"
                                    Margin="9,0,0,0"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"
                                    Background="#E0E0E0"
                                    Foreground="#2D3E50"
                                    BorderThickness="0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>