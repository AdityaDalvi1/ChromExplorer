<UserControl x:Class="ChromExplorer.Modules.Auth.Views.AuditorReport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ChromExplorer.Modules.Auth.Views"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000" Background="#1976D2">

    <!-- ================= MAIN CONTAINER ================= -->
    <Grid Margin="20">

        <!-- ROWS : Header + Table -->
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <Grid Grid.Row="0"
              VerticalAlignment="Center">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- TITLE -->
            <TextBlock Text="User Logs"
               FontSize="24"
               FontWeight="Bold"
               Foreground="#2D3E50"
               VerticalAlignment="Center"
               Margin="5,0,0,0"/>

            <!-- SEARCH AREA -->
            <StackPanel Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                HorizontalAlignment="Right">

                <ComboBox x:Name="cmbFilterType"
          Width="160"
          Height="32"
          Margin="0,0,10,0"
          VerticalAlignment="Center"
          SelectionChanged="cmbFilterType_Changed">

                    <ComboBoxItem Content="Please Select" IsEnabled="False"/>
                    <ComboBoxItem Content="Username"/>
                    <ComboBoxItem Content="Role"/>
                    <ComboBoxItem Content="Action"/>
                    <ComboBoxItem Content="Date"/>

                </ComboBox>
                <TextBox x:Name="txtFilter"
                 Width="200"
                 Height="32"
                 Margin="0,0,10,0"
                 VerticalContentAlignment="Center"
                 Visibility="Collapsed"/>

                <DatePicker x:Name="dpFrom"
                    Width="200"
                    Height="32"
                    Margin="0,0,10,0"
                    Visibility="Collapsed"/>

                <DatePicker x:Name="dpTo"
                    Width="200"
                    Height="32"
                    Margin="0,0,10,0"
                    Visibility="Collapsed"/>

                <Button Content="Search"
                Width="80"
                Height="32"
                Margin="0,0,10,0"
                Background="#007BFF"
                Foreground="Black"
                VerticalAlignment="Center"
                Click="Search_Click"/>

                <Button Content="Clear"
                Width="80"
                Height="32"
                VerticalAlignment="Center"
                Click="Clear_Click"/>

                <Button x:Name="btnExportExcel"
                    Content="Export PDF"
                Width="80"
                Height="32"
                VerticalAlignment="Center"
                Click="Button_ExportPdf_Click"
                 IsEnabled="False"/>

                <Button Content="Back"
        Width="80"
        Height="32"
        Margin="10,0,0,0"
        Click="Back_Click"/>
            </StackPanel>

        </Grid>

        <!-- ================= DATAGRID ================= -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                BorderBrush="#E0E0E0"
                BorderThickness="1">

            <!--<DataGrid x:Name="dgAudit"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      IsReadOnly="True"
                      HorizontalGridLinesBrush="#F0F0F0"
                      BorderThickness="0"
                      Background="Transparent"
                      RowHeight="45"
                      FontSize="14"
                      Padding="10"
                      RowHeaderWidth="0">-->
            <DataGrid x:Name="dgAudit"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          CanUserResizeRows="False"
          CanUserSortColumns="False"
          IsReadOnly="True"
          IsEnabled="True"
          SelectionMode="Single"
          SelectionUnit="FullRow"
          BeginningEdit="dgAudit_BeginningEdit"
          PreviewKeyDown="dgAudit_PreviewKeyDown"
          HorizontalGridLinesBrush="#F0F0F0"
            BorderThickness="0"
            Background="Transparent"
            RowHeight="45"
            FontSize="14"
            Padding="10"
            RowHeaderWidth="0">
                <!-- GLOBAL CELL STYLE (applies to ALL columns) -->
                <DataGrid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="TextWrapping" Value="Wrap"/>
                        <Setter Property="Padding" Value="5,0,5,0"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                </DataGrid.Resources>

                <!-- HEADER STYLE -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8F9FA"/>
                        <Setter Property="Foreground" Value="#5F6368"/>
                        <Setter Property="Padding" Value="10,12"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <!-- COLUMNS -->
                <DataGrid.Columns>

                    <DataGridTextColumn Header="Sr.No" Binding="{Binding SrNo}" Width="60" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="150" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="150" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="150" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="200"/>

                    <!-- Date formatted -->
                    <DataGridTextColumn Header="Inserted Date" Width="180"
                        Binding="{Binding InsertedDate, StringFormat=dd-MMM-yyyy hh:mm tt}" IsReadOnly="True"/>

                    <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="200" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Remark" Binding="{Binding AuditorRemark}" Width="200" IsReadOnly="True"/>
                    <!-- Login Success/Failed store the username in Parameters for the account-lockout
                         attempt count (IsAccountLocked reads it) — it's redundant with the Username
                         column on screen, so it's blanked out here for those two rows only; the
                         underlying data is untouched. -->
                    <DataGridTemplateColumn Header="Parameters" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center" Text="{Binding Parameters}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Action}" Value="Login Success">
                                                    <Setter Property="Text" Value=""/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Action}" Value="Login Failed">
                                                    <Setter Property="Text" Value=""/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Action}" Value="Login Blocked">
                                                    <Setter Property="Text" Value=""/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Add Remark Button -->
                    <!--<DataGridTemplateColumn Header="Add Remark" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Add Remark"
                                        Tag="{Binding AuditLogId}"
                                        Click="AddRemark_Click"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="#007BFF"
                                        Cursor="Hand"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>-->

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ================= POPUP ================= -->
        <Grid x:Name="RemarkPopup"
              Grid.RowSpan="2"
              Background="#80000000"
              Visibility="Collapsed">

            <Border Width="350"
                    Height="220"
                    Background="White"
                    CornerRadius="10"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="15">

                <StackPanel>

                    <TextBlock Text="Add Auditor Remark"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <TextBox x:Name="txtRemark"
                             Height="90"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,10,0,0">

                        <Button Content="Save"
                                Width="80"
                                Margin="5"
                                Background="#28a745"
                                Foreground="Black"
                                Click="SaveRemark_Click"/>

                        <Button Content="Cancel"
                                Width="80"
                                Margin="5"
                                Click="CancelRemark_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>