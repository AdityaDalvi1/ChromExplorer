<UserControl x:Class="ChromExplorer.Modules.Licensing.Views.LicensingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:assets="clr-namespace:ChromExplorer.Assets;assembly=ChromExplorer.Assets"
             xmlns:interactivity="clr-namespace:ChromExplorer.Infrastructure.Interactivity;assembly=ChromExplorer.Infrastructure"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             xmlns:viewModels="clr-namespace:ChromExplorer.Modules.Licensing.ViewModels"
             xmlns:interactionRequest="http://www.codeplex.com/prism"
             xmlns:interactionRequest1="clr-namespace:ChromExplorer.Infrastructure.InteractionRequest;assembly=ChromExplorer.Infrastructure"
             xmlns:views="clr-namespace:ChromExplorer.Modules.Licensing.Views"

             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" d:DataContext="{d:DesignInstance viewModels:LicensingViewViewModel}">
    <Grid>
        <i:Interaction.Triggers>
            <interactionRequest:InteractionRequestTrigger SourceObject="{Binding ConfirmationFromViewModelInteractionRequest}">
                <interactionRequest1:InteractionDialogAction>
                    <interactionRequest1:InteractionDialogAction.Dialog>
                        <views:QrCodeView />
                    </interactionRequest1:InteractionDialogAction.Dialog>
                    <interactionRequest1:InteractionDialogAction.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Image Margin="6,0" Height="24" VerticalAlignment="Center" Source="/ChromExplorer.Infrastructure;component/Images/Question.png" />
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </interactionRequest1:InteractionDialogAction.ContentTemplate>
                </interactionRequest1:InteractionDialogAction>
            </interactionRequest:InteractionRequestTrigger>
            <interactionRequest:InteractionRequestTrigger SourceObject="{Binding WebServiceResponseNotification}">
                <interactionRequest1:InteractionDialogAction>
                    <interactionRequest1:InteractionDialogAction.Dialog>
                        <interactionRequest1:NotificationLocalModalInteractionDialog />
                    </interactionRequest1:InteractionDialogAction.Dialog>
                    <interactionRequest1:InteractionDialogAction.ContentTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Image Margin="5" Height="24" VerticalAlignment="Center" Source="/ChromExplorer.Infrastructure;component/Images/Information.png" />
                                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                <TextBlock Height="Auto" Width="Auto" Margin="5" Text="{Binding}"  TextWrapping="Wrap" FontSize="14" VerticalAlignment="Center" />
                                </ScrollViewer>
                            </Grid>
                        </DataTemplate>
                    </interactionRequest1:InteractionDialogAction.ContentTemplate>
                </interactionRequest1:InteractionDialogAction>
            </interactionRequest:InteractionRequestTrigger>
        </i:Interaction.Triggers>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"></RowDefinition>
            <RowDefinition Height="3*"></RowDefinition>
            <RowDefinition Height="1*"></RowDefinition>

        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"></ColumnDefinition>
            <ColumnDefinition Width="3*"></ColumnDefinition>
            <ColumnDefinition Width="1*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Border Background="#99FFFFFF" Opacity="0.5" CornerRadius="12,12,12,12" VerticalAlignment="Stretch" Grid.RowSpan="3" Grid.ColumnSpan="3" />
        <Grid Grid.Row="1" Grid.Column="1">
            <Border BorderBrush="Black" CornerRadius="12,12,12,12"  Background="#FFC2CCDB"></Border>
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <StackPanel HorizontalAlignment="Right">
                    <Button Margin="3" MinWidth="18" MinHeight="18" Click="Button_Click">
                        <Image Height="16" Width="16" Source="{assets:Asset Icons/Actions/collapse.png}"></Image>
                    </Button>
                </StackPanel>
                <TabControl Grid.Row="1">
                    <TabItem Header="Online">
                        <Grid >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="5">
                                <TextBlock Margin="5" Text="{Binding LicenseStatus}" FontWeight="Bold"></TextBlock>
                                <TextBlock Margin="5">Activation Key</TextBlock>
                                <TextBox Margin="5" Text="{Binding ActivationKey, UpdateSourceTrigger=PropertyChanged}"></TextBox>
                                
                            </StackPanel>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Stretch">
                                    <Button Width="80" Margin="5" HorizontalAlignment="Right" Command="{Binding RegisterCommand}">Register</Button>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Stretch">
                                    <Button Width="80" Margin="5" HorizontalAlignment="Right" Command="{Binding QlmActivateCommand}">Activate</Button>
                                    <Button Width="80" Margin="5" HorizontalAlignment="Right" Command="{Binding QlmDeactivateCommand}">Deactivate</Button>
                                </StackPanel>

                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Offline">
                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="5">
                                <TextBlock Margin="5" Text="{Binding LicenseStatus}" FontWeight="Bold"></TextBlock>
                                <TextBlock Margin="5">Activation Key</TextBlock>
                                <TextBox Margin="5" Text="{Binding ActivationKey, UpdateSourceTrigger=PropertyChanged}"></TextBox>
                                <TextBlock Margin="5">Computer Identifier</TextBlock>
                                <TextBox Margin="5" Text="{Binding ComputerId, UpdateSourceTrigger=PropertyChanged}"></TextBox>
                                <TextBlock Margin="5">Computer Key</TextBlock>
                                <TextBox Margin="5" Text="{Binding ComputerKey, UpdateSourceTrigger=PropertyChanged}"></TextBox>
                            </StackPanel>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Stretch">
                                    <Button Width="80" Margin="5" HorizontalAlignment="Right" Command="{Binding RegisterOfflineCommand}">Register</Button>
                                    <Button Width="120" Margin="5" HorizontalAlignment="Right" Command="{Binding GetOfflineActivationCodeCommand}">Get Computer Key</Button>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Stretch">
                                    <Button Width="80" Margin="5" HorizontalAlignment="Right" Command="{Binding QlmActivateOfflineCommand}">Activate</Button>
                                    <Button Width="80" Margin="5" HorizontalAlignment="Right" Command="{Binding QlmDeactivateOfflineCommand}">Deactivate</Button>
                                </StackPanel>

                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>


            </Grid>


        </Grid>


    </Grid>
</UserControl>































