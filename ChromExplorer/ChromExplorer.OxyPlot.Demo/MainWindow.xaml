<Window x:Class="ChromExplorer.OxyPlot.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChromExplorer.OxyPlot.Demo"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:converters="clr-namespace:ChromExplorer.Infrastructure.Converters;assembly=ChromExplorer.Infrastructure"

        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" >
    <Window.Background>
        <ImageBrush ImageSource="Resources/dna_bg_r.png"  Stretch="UniformToFill"/>
    </Window.Background>
    <Window.Resources>
        <ResourceDictionary>
            <converters:SpectrumTypeToVisibilityConverter x:Key="typeToVisibility" />
        </ResourceDictionary>
    </Window.Resources>


    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"></ColumnDefinition>
            <ColumnDefinition Width="1*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="1*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="1*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Background="LightBlue" HorizontalAlignment="Stretch">
            <!--Width="{Binding
                                 RelativeSource={RelativeSource
                                 Mode=FindAncestor,
                                 AncestorType={x:Type Expander}},
                                 Path=ActualWidth}"-->

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                        Text="{Binding Chromatogram.Title}"
                        ToolTip="{Binding Chromatogram.Description}"
                        Background="LightBlue" />
            <StackPanel Orientation="Horizontal" Margin="5,0,0,0" Grid.Column="2">
                <TextBlock Margin="10, 3, 3, 3">Index</TextBlock>
                <TextBlock Width="60" Margin="3"
                                   Text="{Binding Chromatogram.SelectedSpectumIndex, StringFormat={}{0:0}}" />
            </StackPanel>
            <!--<StackPanel Orientation="Horizontal" Margin="5,0,0,0" Grid.Column="3">
                <TextBlock Margin="10, 3, 3, 3">Count</TextBlock>
                <TextBlock Width="60" Margin="3"
                                   Text="{Binding Chromatogram.SelectedIndexesCount, StringFormat={}{0:0}}" />
            </StackPanel>-->
            <StackPanel Orientation="Horizontal" Margin="5,0,0,0" Grid.Column="4">
                <TextBlock Margin="10, 3, 3, 3">SIC</TextBlock>
                <TextBlock Width="60" Margin="3"
                                   Text="{Binding Chromatogram.SelectedSIC, StringFormat={}{0:#.##E+0}}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5,0,0,0" Grid.Column="5">
                <TextBlock Margin="10, 3, 3, 3">Total</TextBlock>
                <TextBlock Width="60" Margin="3"
                                   Text="{Binding Chromatogram.InstrumentChromatogram.Count, StringFormat={}{0:0}}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5,0,0,0" Grid.Column="6">
                <TextBlock Margin="10, 3, 3, 3">Area</TextBlock>
                <TextBlock Width="60" Margin="3" Text="{Binding ChromPlotModel.TicArea, StringFormat={}{0:#.##E+0}}" />
            </StackPanel>
            <Menu Grid.Column="7" Background="LightBlue">
                <MenuItem Header="Export">
                    <MenuItem Header="Chromatogram" Command="{Binding ExportChromCommand}" />
                </MenuItem>
            </Menu>
        </Grid>

        <oxy:PlotView Grid.Row="1" Grid.Column="0" Margin="3" Model="{Binding ChromPlotModel}" Controller="{Binding ChromPlotController}"></oxy:PlotView>
        <Grid Grid.Row="2" Margin="0, 0, 0, 10" Background="LightBlue">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <StackPanel  Background="LightBlue" Orientation="Horizontal">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Width="50" Margin="3" Text="{Binding Chromatogram.CurrentSpectrum.Type}"></TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="5,0,0,0">
                    <TextBlock Margin="10, 3, 3, 3">Index:</TextBlock>
                    <TextBlock Width="45" Margin="3" Text="{Binding Chromatogram.CurrentSpectrum.Index}"></TextBlock>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="5,0,0,0">
                    <TextBlock Margin="10, 3, 3, 3">IT (sec):</TextBlock>
                    <TextBlock Width="60" Margin="3" Text="{Binding Chromatogram.CurrentSpectrum.InjectionTime, StringFormat={}{0:0.###}}"></TextBlock>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="5,0,0,0">
                    <TextBlock Margin="10, 3, 3, 3">R.Time:</TextBlock>
                    <TextBlock Width="60" Margin="3" Text="{Binding Chromatogram.CurrentSpectrum.RetentionTime, StringFormat={}{0:0.0}}"></TextBlock>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="5,0,0,0" Visibility="{Binding Chromatogram.CurrentSpectrum.Type, Converter={StaticResource typeToVisibility}}">
                    <TextBlock Margin="10, 3, 3, 3">Parent</TextBlock>
                    <TextBlock Width="80" Margin="3" Text="{Binding Chromatogram.CurrentSpectrum.ParentIon, StringFormat={}{0:0.00}}"></TextBlock>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="5,0,0,0">
                    <TextBlock Margin="10, 3, 3, 3">TIC:</TextBlock>
                    <TextBlock Margin="3" Text="{Binding Chromatogram.CurrentSpectrum.TIC, StringFormat={}{0:0}}"></TextBlock>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="5,0,0,0">
                    <TextBlock Margin="10, 3, 3, 3">Timestamp:</TextBlock>
                    <TextBlock Margin="3" Text="{Binding Chromatogram.CurrentSpectrum.TimestampStr}"></TextBlock>
                </StackPanel>

            </StackPanel>
            <Grid Grid.Column="2">
                <StackPanel Orientation="Horizontal">

                    <Menu Background="LightBlue">
                        <!--<MenuItem Header="Search">
                            <MenuItem Header="NIST - New" Command="{Binding NistLibrarySearchCommand}" ></MenuItem>
                            <MenuItem Header="NIST - Append" Command="{Binding NistLibrarySearchCommand }" CommandParameter="APPEND"></MenuItem>
                        </MenuItem>-->
                        <MenuItem Header="Export">
                            <MenuItem Header="Spectrum..." Command="{Binding ExportSpectrumCommand}"></MenuItem>
                            <MenuItem Header="Peak List..."  Command="{Binding ExportPeakListCommand}"></MenuItem>
                            <MenuItem Header="NIST Text..."  Command="{Binding ExportNistTextCommand}"></MenuItem>
                            <Separator></Separator>
                            <MenuItem Header="Copy Mascot (Exact Mass)" Command="{Binding CopyMascotCommand}" CommandParameter="true"></MenuItem>
                            <MenuItem Header="Copy Mascot (Nominal Mass)" Command="{Binding CopyMascotCommand}" CommandParameter="false"></MenuItem>
                            <MenuItem Header="Copy Wiley Peak List" Command="{Binding CopyWileyCommand}" CommandParameter="false"></MenuItem>
                        </MenuItem>
                    </Menu>
                </StackPanel>

            </Grid>
        </Grid>
        <oxy:PlotView Grid.Row="3" Grid.Column="0" Margin="3" Model="{Binding SpectrumModel}" Controller="{Binding SpectrumController}"></oxy:PlotView>

        <StackPanel Grid.Row="1" Grid.Column="1" Grid.RowSpan="3" Orientation="Vertical">
            <Button Command="{Binding TestCommand}">Test</Button>
            <Button Command="{Binding CopyToClipboardCommand}">Copy</Button>
            <Button Command="{Binding FitCommand}">Fit</Button>
            <Button Command="{Binding RemoveXRangesCommand}">RemoveXRanges</Button>
            <Button Command="{Binding FilterChromCommand}" CommandParameter="-1">All Data</Button>
            <Button Command="{Binding FilterChromCommand}" CommandParameter="1">MS</Button>
            <Button Command="{Binding FilterChromCommand}" CommandParameter="2">MSMS</Button>
            <Button Command="{Binding SaveAllChromCommand}">Save All Chromatograms</Button>
            <StackPanel Orientation="Horizontal">
                <TextBox Width="30" Margin="5" Text="{Binding ParentIon}"></TextBox>
                <TextBox Width="30" Margin="5" Text="{Binding StartTime}"></TextBox>
                <TextBox Width="30" Margin="5" Text="{Binding StopTime}"></TextBox>
                <Button Command="{Binding SaveMsMsCommand}">Save</Button>
            </StackPanel>
            <Button Command="{Binding LCPlotCommand}">LC Plot</Button>

        </StackPanel>
    </Grid>
</Window>
